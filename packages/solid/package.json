{
  "name": "@calendar-tsx/solid",
  "version": "0.2.0",
  "description": "Solid bindings for @calendar-tsx/core: unstyled, composable calendar parts.",
  "license": "MIT",
  "author": "Frantss <frantss.bongiovanni@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Frantss/calendar-tsx.git",
    "directory": "packages/solid"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "imports": {
    "#calendar-factory": "./src/calendar-factory.tsx",
    "#list-view": "./src/list-view.tsx",
    "#day-grid-view": "./src/day-grid-view.tsx",
    "#time-grid-view": "./src/time-grid-view.tsx",
    "#timeline-view": "./src/timeline-view.tsx",
    "#use-calendar": "./src/use-calendar.tsx",
    "#tests/calendar-solid.setup": "./src/tests/calendar-solid.setup.tsx",
    "#tests/ssr.app": "./src/tests/ssr.app.tsx",
    "#*": "./src/*.ts"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vp pack",
    "test": "vp test",
    "test:dev": "vp test --watch",
    "check:types": "vp exec tsc --noEmit",
    "check:package": "publint --strict && attw --pack --no-emoji --profile esm-only"
  },
  "dependencies": {
    "@calendar-tsx/core": "workspace:*",
    "@tanstack/solid-store": "^0.11.2",
    "@tanstack/store": "^0.11.2"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@calendar-tsx/rrule": "workspace:*",
    "publint": "^0.3.25",
    "solid-js": "1.9.17",
    "temporal-polyfill": "^1.0.6",
    "typescript": "^7.0.2",
    "vite-plugin-solid": "^2.11.14"
  },
  "peerDependencies": {
    "solid-js": "^1.8.0",
    "temporal-polyfill": "^1.0.6"
  }
}
