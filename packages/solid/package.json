{
  "name": "@calendar-tsx/solid",
  "version": "0.3.0",
  "description": "Solid bindings for @calendar-tsx/core: unstyled, composable calendar parts.",
  "license": "MIT",
  "author": "Frantss <frantss.bongiovanni@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Frantss/calendar-tsx.git",
    "directory": "packages/solid"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "imports": {
    "#rendering/factory": "./src/rendering/factory.tsx",
    "#views/list/list-view": "./src/views/list/list-view.tsx",
    "#views/day-grid/day-grid-view": "./src/views/day-grid/day-grid-view.tsx",
    "#views/time-grid/time-grid-view": "./src/views/time-grid/time-grid-view.tsx",
    "#views/timeline/timeline-view": "./src/views/timeline/timeline-view.tsx",
    "#calendar/calendar": "./src/calendar/calendar.tsx",
    "#tests/support/calendar.setup": "./src/tests/support/calendar.setup.tsx",
    "#tests/integration/ssr/app": "./src/tests/integration/ssr/app.tsx",
    "#*": "./src/*.ts"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./v2": {
      "types": "./dist/v2/index.d.ts",
      "import": "./dist/v2/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vp pack && pnpm --dir v2 build:v2",
    "test": "vp test && pnpm --dir v2 test:v2",
    "test:dev": "vp test --watch",
    "check:types": "vp exec tsc --noEmit && vp exec tsc -p tests/types && vp exec tsc -p tests/types/tsconfig.public.json && pnpm --dir v2 check:types:v2",
    "check:package": "publint --strict && attw --pack --no-emoji --profile esm-only"
  },
  "dependencies": {
    "@calendar-tsx/core": "workspace:*",
    "@tanstack/solid-store": "^0.11.2",
    "@tanstack/store": "^0.11.2"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@calendar-tsx/rrule": "workspace:*",
    "publint": "^0.3.25",
    "solid-js": "1.9.17",
    "temporal-polyfill": "^1.0.6",
    "typescript": "^7.0.2",
    "vite-plugin-solid": "^2.11.14"
  },
  "peerDependencies": {
    "@solidjs/web": "^2.0.0-rc.19",
    "solid-js": "^1.8.0 || ^2.0.0-rc.19",
    "temporal-polyfill": "^1.0.6"
  },
  "peerDependenciesMeta": {
    "@solidjs/web": {
      "optional": true
    }
  }
}
