{
  "name": "@calendar-tsx/react",
  "version": "0.2.0",
  "description": "React bindings for @calendar-tsx/core: unstyled, composable calendar parts.",
  "license": "MIT",
  "author": "Frantss <frantss.bongiovanni@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Frantss/calendar-tsx.git",
    "directory": "packages/react"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "imports": {
    "#rendering/factory": "./src/rendering/factory.tsx",
    "#views/list/list-view": "./src/views/list/list-view.tsx",
    "#views/day-grid/day-grid-view": "./src/views/day-grid/day-grid-view.tsx",
    "#views/time-grid/time-grid-view": "./src/views/time-grid/time-grid-view.tsx",
    "#views/timeline/timeline-view": "./src/views/timeline/timeline-view.tsx",
    "#calendar/calendar": "./src/calendar/calendar.tsx",
    "#tests/support/calendar.setup": "./src/tests/support/calendar.setup.tsx",
    "#*": "./src/*.ts"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vp pack",
    "test": "vp test",
    "test:dev": "vp test --watch",
    "check:types": "vp exec tsc --noEmit && vp exec tsc -p tests/types && vp exec tsc -p tests/types/tsconfig.public.json",
    "check:package": "publint --strict && attw --pack --no-emoji --profile esm-only"
  },
  "dependencies": {
    "@calendar-tsx/core": "workspace:*",
    "@tanstack/react-store": "^0.11.2",
    "@tanstack/store": "^0.11.2"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@calendar-tsx/rrule": "workspace:*",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "publint": "^0.3.25",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "temporal-polyfill": "^1.0.6",
    "typescript": "^7.0.2",
    "vitest-browser-react": "^2.3.0"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0",
    "temporal-polyfill": "^1.0.6"
  }
}
