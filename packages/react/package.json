{
  "name": "@calendar-tsx/react",
  "version": "0.0.0",
  "description": "React bindings for @calendar-tsx/core: unstyled, composable calendar parts.",
  "license": "MIT",
  "author": "Frantss <frantss.bongiovanni@gmail.com>",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "imports": {
    "#calendar-factory": "./src/calendar-factory.tsx",
    "#list-view": "./src/list-view.tsx",
    "#month-view": "./src/month-view.tsx",
    "#time-grid-view": "./src/time-grid-view.tsx",
    "#use-calendar": "./src/use-calendar.tsx",
    "#tests/calendar-react.setup": "./src/tests/calendar-react.setup.tsx",
    "#*": "./src/*.ts"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vp pack",
    "test": "vp test",
    "test:dev": "vp test --watch",
    "check:types": "vp exec tsc --noEmit",
    "check:package": "publint --strict && attw --pack --no-emoji"
  },
  "dependencies": {
    "@calendar-tsx/core": "workspace:*",
    "@tanstack/react-store": "^0.11.2",
    "@tanstack/store": "^0.11.2",
    "temporal-polyfill": "^1.0.6"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "publint": "^0.3.25",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "^7.0.2",
    "vitest-browser-react": "^2.3.0"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  }
}
