    "@storybook/addon-vitest": "10.6.3",
    "@storybook/react-vite": "10.6.3",
    "@tanstack/store": "^0.11.2",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "storybook": "10.6.3",
    "temporal-polyfill": "^1.0.6",
    "typescript": "^7.0.2"
  }
